<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>muralistas_bringup</name>
  <version>0.1.0</version>
  <description>Arranque de Pequeños Muralistas: launch, configuración por niño y RViz.</description>
  <maintainer email="jorgelolpez07@gmail.com">Robotics for Inclusion Workshop</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>muralistas_sim</exec_depend>
  <exec_depend>muralistas_perception</exec_depend>
  <exec_depend>muralistas_planning</exec_depend>
  <exec_depend>muralistas_control</exec_depend>
  <exec_depend>muralistas_hri</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
