<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>muralistas_hri</name>
  <version>0.1.0</version>
  <description>Interacción: filtro del switch, barrido por peldaños, pantalla de pictogramas y registro de decisiones.</description>
  <maintainer email="jorgelolpez07@gmail.com">Robotics for Inclusion Workshop</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>muralistas_interfaces</exec_depend>
  <exec_depend>muralistas_common</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
