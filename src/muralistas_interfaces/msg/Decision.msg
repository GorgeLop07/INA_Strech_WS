# Una decisión registrada (base de la métrica "% de decisiones propias").
builtin_interfaces/Time stamp
string user_id
uint8 level
string mode
string stage             # qué se estaba eligiendo
string choice            # qué se eligió
string source            # "nino", "adulto" o "auto"
float32 response_time    # segundos desde que empezó la pregunta
int32 scan_cycles        # vueltas completas del barrido antes de elegir
