<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>muralistas_perception</name>
  <version>0.1.0</version>
  <description>Percepción con la cámara de la cabeza: nube 3D, pose del mural con ArUco + profundidad y segmentación del pincel.</description>
  <maintainer email="jorgelolpez07@gmail.com">Robotics for Inclusion Workshop</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>muralistas_interfaces</exec_depend>
  <exec_depend>muralistas_common</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
